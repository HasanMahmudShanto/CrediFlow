
@{
    ViewBag.Title = "Index";
}

<h2>Notifications</h2>

<div class="container mt-4">
    <a href="@Url.Action("Upsert", "Notification")" class="btn btn-success my-3">
        + Add New Notification
    </a>
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th class="col-header">#</th>
                <th class="col-header">Notification_Id</th>
                <th class="col-header">Title</th>
                <th class="col-header">Message</th>
                <th class="col-header">Date</th>
                <th class="col-header">Customer_Id</th>
                <th class="col-header">Is_Read</th>
                <th class="col-header">Actions</th>

            </tr>
        </thead>
        <tbody id="notificationTableBody">
        </tbody>
    </table>
</div>

<script>
    const upsertUrlBase = '@Url.Action("Upsert", "Notification")';
</script>

@section scripts {
    <script src="@Url.Content("~/Scripts/notification.js")" type="text/javascript"></script>
}