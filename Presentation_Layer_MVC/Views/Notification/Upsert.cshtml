
@{
    ViewBag.Title = "Upsert";
}

<h2>Upsert</h2>


@{
    // The ID will be null, and the Title will be "Create New Customer"
    int? Notification_Id = (int?)ViewBag.Notification_Id;
}


<form id="NotificationUpsertForm">

    @if (Notification_Id == null)
    {
        <div class="form-group"><label>Title</label><input type="text" class="form-control" id="Title" required></div>
        <div class="form-group">
            <label for="Message">Message</label>
            <textarea class="form-control" id="Message" required></textarea>
        </div>
        <div class="form-group"><label>Customer_Id</label><input type="number" step="1" class="form-control" id="Customer_Id" required></div>
        <div class="form-group">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="Is_Read" name="Is_Read">
                <label class="form-check-label" for="Is_Read">
                    Is Read
                </label>
            </div>
        </div>
        <button type="submit" class="btn btn-success" id="saveUpsertBtn">Create Notification</button>
    }
    else
    {

        <div class="form-group"><label>Notification_Id</label><input type="number" step="1" class="form-control" id="Notification_Id" value="@Notification_Id" disabled></div>
        <div class="form-group"><label>Title</label><input type="text" class="form-control" id="Title" required></div>
        <div class="form-group">
            <label for="Message">Message</label>
            <textarea class="form-control" id="Message" required></textarea>
        </div>

        <div class="form-group">
            <label for="Date">Date</label>
            <input type="datetime-local" class="form-control" id="Date" name="Date" required>
        </div>

        <div class="form-group"><label>Customer_Id</label><input type="number" step="1" class="form-control" id="Customer_Id" required></div>
        <div class="form-group">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="Is_Read" name="Is_Read">
                <label class="form-check-label" for="Is_Read">
                    Is Read
                </label>
            </div>
        </div>
        <button type="submit" class="btn btn-success" id="saveUpsertBtn">Update Notification</button>
    }
</form>

<script>
    const redirectUrl = '@Url.Action("Index", "Notification")';

</script>

@section scripts {
    <script src="@Url.Content("~/Scripts/Notification_upsert.js")" type="text/javascript"></script>
}