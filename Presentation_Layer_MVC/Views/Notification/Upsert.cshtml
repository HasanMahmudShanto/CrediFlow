
@{
    ViewBag.Title = "Upsert";
}

<h2>Upsert</h2>


@{
    // The ID will be null, and the Title will be "Create New Customer"
    int? Notification_Id = (int?)ViewBag.Notification_Id;
}


<form id="NotificationUpsertForm" novalidate>

    @if (Notification_Id == null)
    {
        <div class="form-group"><label>Title</label><input type="text" class="form-control" id="Title" required></div>
        <div class="form-group">
            <label for="Message">Message</label>
            <textarea class="form-control" id="Message" required></textarea>
        </div>
        <div class="form-group">
            <label for="CustomerSelect">Customer Name</label>
            <select class="form-control" id="CustomerSelect" required>
                <option value="">-- Select a Customer --</option>
            </select>
            <input type="hidden" id="Customer_Id" />
        </div>
        <div class="form-group">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="Is_Read" name="Is_Read">
                <label class="form-check-label" for="Is_Read">
                    Is Read
                </label>
            </div>
        </div>
        <button type="submit" class="btn btn-success" id="saveUpsertBtn">Create Notification</button>
    }
    else
    {

        <div class="form-group"><label>Notification_Id</label><input type="number" step="1" class="form-control" id="Notification_Id" value="@Notification_Id" disabled></div>
        <div class="form-group"><label>Title</label><input type="text" class="form-control" id="Title" required></div>
        <div class="form-group">
            <label for="Message">Message</label>
            <textarea class="form-control" id="Message" required></textarea>
        </div>

        <div class="form-group">
            <label for="Date">Date</label>
            <input type="datetime-local" class="form-control" id="Date" name="Date" required>
        </div>

        <div class="form-group">
            <label for="CustomerSelect">Customer Name</label>
            <select class="form-control" id="CustomerSelect" required>
                <option value="">-- Select a Customer --</option>
            </select>
            <input type="hidden" id="Customer_Id" />
        </div>
        <div class="form-group">
            <div class="form-check">
                <input type="checkbox" class="form-check-input" id="Is_Read" name="Is_Read">
                <label class="form-check-label" for="Is_Read">
                    Is Read
                </label>
            </div>
        </div>
        <button type="submit" class="btn btn-success" id="saveUpsertBtn">Update Notification</button>
    }
</form>


<div class="modal fade" id="validationModal" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalLabel">Validation Error</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul id="errorList">
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    window.redirectUrl = '@Url.Action("Index", "Notification")';
</script>

@section scripts {
    <script src="@Url.Content("~/Scripts/Notification_upsert.js")" type="text/javascript"></script>
}