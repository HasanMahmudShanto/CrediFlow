
@{
    ViewBag.Title = "Upsert";
}

<h2>Upsert</h2>

@{
    // The ID will be null, and the Title will be "Create New Customer"
    int? CustomerId = (int?)ViewBag.Customer_Id;
}


<form id="customerUpsertForm">

    @if (CustomerId == null)
    {
        <div class="form-group"><label>Name</label><input type="text" class="form-control" id="Name" required></div>
        <div class="form-group"><label>Address</label><input type="text" class="form-control" id="Address" required></div>
        <div class="form-group"><label>Email</label><input type="email" class="form-control" id="Email" required></div>
        <div class="form-group">
            <label>Gender</label>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="GenderOption" id="GenderMale" value="1.0" required>
                <label class="form-check-label" for="GenderMale">Male</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="GenderOption" id="GenderFemale" value="0.0">
                <label class="form-check-label" for="GenderFemale">Female</label>
            </div>
        </div>
        <div class="form-group"><label>Card Number</label><input type="text" class="form-control" id="Card_Number" required></div>
        <div class="form-group"><label>Monthly Income (Float)</label><input type="number" step="100.0" class="form-control" id="Monthly_Income" required></div>

        <button type="submit" class="btn btn-success" id="saveUpsertBtn">Create Customer</button>
    }
    else
    {
        <div class="form-group"><label>Customer Id</label><input type="text" class="form-control" id="CustomerId" placeholder= "@CustomerId" value="@CustomerId" disabled></div>
        <div class="form-group"><label>Name</label><input type="text" class="form-control" id="Name" required></div>
        <div class="form-group"><label>Address</label><input type="text" class="form-control" id="Address" required></div>
        <div class="form-group"><label>Email</label><input type="email" class="form-control" id="Email" required></div>
        <div class="form-group"><label>Credit Score</label><input type="number" step="1.0" class="form-control" id="Credit_Score" required></div>

        <div class="form-group">
            <label>Gender</label>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="GenderOption" id="GenderMale" value="1.0" required>
                <label class="form-check-label" for="GenderMale">Male</label>
            </div>
            <div class="form-check form-check-inline">
                <input class="form-check-input" type="radio" name="GenderOption" id="GenderFemale" value="0.0">
                <label class="form-check-label" for="GenderFemale">Female</label>
            </div>
        </div>
        <div class="form-group"><label>Card Number</label><input type="text" class="form-control" id="Card_Number" required></div>
        <div class="form-group"><label>Monthly Income (Float)</label><input type="number" step="100.0" class="form-control" id="Monthly_Income" required></div>
        <div class="form-group">
            <label for="Status">Status</label>
            <select name="Status" id="Status">
                <option value="Terminated">Terminated</option>
                <option value="Restricted">Restricted</option>
                <option value="Poor">Poor</option>
                <option value="Fair">Fair</option>
                <option value="Best">Best</option>
            </select>
        </div>

        <button type="submit" class="btn btn-success" id="saveUpsertBtn">Update Customer</button>
    }
</form>

<div class="modal fade" id="validationModal" tabindex="-1" role="dialog" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="modalLabel">Validation Error</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <ul id="errorList">
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<script>
    const redirectUrl = '@Url.Action("Index", "Customer")';

</script>

@section scripts {
    <script src="@Url.Content("~/Scripts/upsert.js")" type="text/javascript"></script>
}
