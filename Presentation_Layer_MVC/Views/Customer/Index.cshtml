
@{
    ViewBag.Title = "Index";
}

<h2>Customer List</h2>

<div class="container mt-4">
    <a href="@Url.Action("Upsert", "Customer")" class="btn btn-primary my-3">
        + Add New Customer
    </a>
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th class="col-header">#</th>
                <th class="col-header">Customer_Id</th>
                <th class="col-header">Name</th>
                <th class="col-header">Credit_Score</th>
                <th class="col-header">Gender</th>
                <th class="col-header">Address</th>
                <th class="col-header">Card_Number</th>
                <th class="col-header">Monthly_Income</th>
                <th class="col-header">Status</th>
                <th class="col-header">Email</th>
                <th class="col-header">Actions</th>
            </tr>
        </thead>
        <tbody id="customerTableBody">
        </tbody>
    </table>
</div>

<script>
    const upsertUrlBase = '@Url.Action("Upsert", "Customer")';
</script>

@section scripts {
    <script src="@Url.Content("~/Scripts/app.js")" type="text/javascript"></script>
}